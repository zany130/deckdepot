{
  "name": "deckdepot",
  "version": "1.0.1",
  "description": "Browse, install, update, and manage user Flatpaks and optional AppMan apps from Steam Gaming Mode. Add to Steam is optional; Steam launches the app.",
  "type": "module",
  "scripts": {
    "build": "rollup -c",
    "watch": "rollup -c -w",
    "package": "bash scripts/package.sh",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [
    "decky",
    "plugin",
    "deckdepot",
    "flatpak",
    "appman",
    "linux"
  ],
  "author": "Andres",
  "license": "BSD-3-Clause",
  "devDependencies": {
    "@decky/rollup": "^1.0.2",
    "@decky/ui": "^4.11.0",
    "@rollup/rollup-linux-x64-musl": "^4.53.3",
    "@types/react": "19.1.1",
    "@types/react-dom": "19.1.1",
    "@types/webpack": "^5.28.5",
    "rollup": "^4.53.3",
    "typescript": "^5.6.2"
  },
  "dependencies": {
    "@decky/api": "^1.1.3",
    "react-icons": "^5.3.0",
    "tslib": "^2.7.0",
    "zod": "^4.6.5"
  },
  "pnpm": {
    "peerDependencyRules": {
      "ignoreMissing": [
        "react",
        "react-dom"
      ]
    }
  }
}
